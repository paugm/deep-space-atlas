{
  "name": "deep-space-atlas",
  "version": "0.22.0",
  "private": true,
  "license": "MIT",
  "description": "First-person mining and exploration in the browser. A 32-bit seed builds the terrain, biome, resources, decoration, planet name, and spawn.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && npm test && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "three": "0.187.0",
    "tone": "15.1.22"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
