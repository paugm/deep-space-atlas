{
  "name": "deep-space-atlas",
  "version": "0.19.0",
  "private": true,
  "license": "MIT",
  "description": "First-person mining and exploration in the browser. A 32-bit seed builds the terrain, biome, resources, decoration, planet name, and spawn.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && npm test && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "three": "0.185.1",
    "threejs-psx-shader": "github:lferreira457/threejs-psx-shader"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/three": "0.185.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
